      "text": "this.x = $0 / 2              \nthis.y = $1 * 2              \nthis.width = 15 + 15         \nthis.height = 12 + 18        \nthis.rotation = 3 / 2 - 1.5  \nthis.red = 100 + 100 + 55    \nthis.green = 100 + 55 + 100  \nthis.blue = 100 / 2          \nthis.border_width = 2 + 2    \nthis.border_red = 55 + 55    \nthis.border_green = 66 - 10  \nthis.border_blue = $0 / $1   \n",
